# =============================================================================
# OrionShop Profit Dashboard — E2E Environment Variables
# =============================================================================
# Copy this file to .env.e2e.local and fill in the values for your environment.
#   cp .env.e2e.example .env.e2e.local
#
# Then run:   npm run test:e2e
# =============================================================================

# Base URL of the running application.
# Defaults to http://localhost:3000 when not set.
# E2E_BASE_URL=http://localhost:3000

# Scope params — company/account query string that scopes each request to a
# specific tenant.  Omit if the app auto-selects a default tenant.
# Prefer from/to on or before last successful sync day so DashboardOperationalSync
# does not fire mid-test (end date newer than last sync triggers auto-sync).
# Example: E2E_SCOPE_PARAMS=company=1&account=1&from=2026-07-28&to=2026-07-28
# E2E_SCOPE_PARAMS=

# Set to "1" to skip spawning the dev server (use when the app is already
# running in a separate terminal).
# E2E_SKIP_WEBSERVER=1

# Set to "1" to reuse the existing e2e/.auth/session.json instead of
# re-running global setup (speeds up re-runs during development).
# E2E_REUSE_SESSION=1

# Sprint 7.1.B — Supabase Auth user for Playwright global setup (required).
# Create this user in Supabase Dashboard → Authentication → Users.
# E2E_USER_EMAIL=e2e@example.com
# E2E_USER_PASSWORD=

# Sprint 7.1.C — Grant tenant membership after creating the user:
#   npm run grant:tenant-access -- --email e2e@example.com
# (or: node scripts/provision-e2e-auth-user.mjs which grants all companies)
