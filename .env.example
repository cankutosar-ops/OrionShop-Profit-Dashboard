# =============================================================================
# OrionShop Profit Dashboard — Environment Variables
# =============================================================================
# Copy to .env.local and fill in your credentials:
#   cp .env.example .env.local
# =============================================================================

# Supabase (required for dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (required for sync writes — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — apply migrations via scripts/apply-*-migration.mjs (Dashboard → Database → password)
# SUPABASE_DB_PASSWORD=
# Or: SUPABASE_ACCESS_TOKEN=  (Dashboard → Account → Access Tokens)

# Marketplace credentials encryption (32-byte key, base64 — generate with openssl rand -base64 32)
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset
MARKETPLACE_CREDENTIALS_KEY=

# Wildberries API (legacy fallback — copied to default marketplace account on first run)
# Per-account keys are managed in Settings → Companies
WB_API_TOKEN=your-wildberries-api-token
