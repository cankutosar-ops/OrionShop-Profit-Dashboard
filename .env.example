# =============================================================================
# OrionShop Profit Dashboard — Environment Variables
# =============================================================================
# Copy to .env.local and fill in your credentials:
#   cp .env.example .env.local
# =============================================================================

# Supabase (required for dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (REQUIRED — server data plane / admin; never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — apply migrations via scripts/apply-*-migration.mjs (Dashboard → Database → password)
# SUPABASE_DB_PASSWORD=
# Or: SUPABASE_ACCESS_TOKEN=  (Dashboard → Account → Access Tokens)

# Marketplace credentials encryption (REQUIRED in production)
# Generate: openssl rand -base64 32
# Do not reuse SUPABASE_SERVICE_ROLE_KEY in production.
MARKETPLACE_CREDENTIALS_KEY=

# Sprint 7.1.E — dedicated secret for containment cookie HMAC + CLI/server→API Bearer.
# REQUIRED in production. Do not use the service_role key as the API password.
# Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

# Sprint 7.1.B — Authentication uses Supabase Auth (anon key + HttpOnly cookies).
# Create users in Supabase Dashboard → Authentication → Users (email/password).
# Do not put passwords in this file — use .env.local / .env.e2e.local only.

# Sprint 7.1.C — Tenant membership is stored in Auth app_metadata.orion (not RLS).
# Grant access: npm run grant:tenant-access -- --email user@example.com

# Sprint 7.1.D — After applying RLS migrations, set to 1 for JWT data plane:
# ORION_RLS_DATA_PLANE=1

# Wildberries API (legacy seed only — prefer per-account keys in Settings)
# WB_API_TOKEN=

# Fail-closed reservation for the active Account 2 Finance recovery campaign.
# Production (required while recovery is active — local JSON is NOT visible to cron):
#   Vercel Dashboard → this project → Settings → Environment Variables
#   Name: ACCOUNT2_FINANCE_RECOVERY_CAMPAIGN_ACTIVE
#   Value: true
#   Environments: Production (and Preview if cron/API run there)
# Redeploy or wait for the next cron after saving so serverless reads the new value.
# Also set the same variable in operator .env.local before any recovery wake.
# Remove / set false only after the campaign is completed or explicitly aborted.
# ACCOUNT2_FINANCE_RECOVERY_CAMPAIGN_ACTIVE=true

# Finance V1 live HTTP opt-in (default OFF). Required before any Account 2
# Finance V1 sales-reports request. Do NOT enable until Personal/Service+Finance
# token is configured and a controlled one-page wake is authorized.
# FINANCE_V1_LIVE_REQUESTS_ENABLED=false

# Comma-separated marketplace account ids migrated onto the Reports/V1 finance
# kernel, e.g. FINANCE_V1_ACCOUNT_IDS=1
#
# Migration is per account on purpose. FINANCE_V1_LIVE_REQUESTS_ENABLED is a
# single global switch, so using it alone to migrate one account would move
# every account at once — and any account without a seeded
# finance_incremental_sync_state row would stop ingesting finance.
#
# An account listed here needs BOTH this allowlist and the live flag above.
# Before adding an id, seed its anchor:
#   npx tsx scripts/seed-finance-incremental-state.mjs --account <id> --apply
# An account routed here without a seeded anchor now fails loudly rather than
# reporting a successful sync that ingested nothing.
#
# Account 2 predates this allowlist and is on Reports/V1 unconditionally.
# FINANCE_V1_ACCOUNT_IDS=1
