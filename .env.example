# =============================================================================
# OrionShop Profit Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your Supabase project credentials.
#
#   cp .env.example .env.local
#
# Find your credentials at: https://supabase.com/dashboard/project/_/settings/api
# =============================================================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Wildberries API (future integration — not used yet)
WB_API_TOKEN=
WB_API_BASE_URL=https://suppliers-api.wildberries.ru
